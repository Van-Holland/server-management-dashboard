# Copy to `.env` on mulderserver, next to docker-compose.yml, and fill in.
# `.env` is gitignored and dockerignored — it is read by compose at run time and
# never baked into the image. Do not commit real values.

# qBittorrent WebUI. Reached through gluetun's published port, not its own.
# Username/password are OPTIONAL: qBittorrent's AuthSubnetWhitelist trusts the
# Docker subnet (172.16.0.0/12), so the dashboard needs no login. Set them only
# if that whitelist is ever removed.
QBIT_URL=http://192.168.178.241:8080
# QBIT_USERNAME=admin
# QBIT_PASSWORD=

# SABnzbd. The API key is in Config -> General in its web UI.
SAB_URL=http://192.168.178.241:8081
SAB_API_KEY=

# slskd (Soulseek). Like qBittorrent, its port is published by gluetun rather
# than by its own compose file, because it shares gluetun's network namespace.
# Use a dedicated API key from slskd.yml's web.authentication.api_keys block —
# NOT the web UI password. `readonly` is enough for the downloads card.
SLSKD_URL=http://192.168.178.241:5030
SLSKD_API_KEY=

# Minimum gap between speedtests, in ms. Defaults to 15 minutes.
# SPEEDTEST_MIN_INTERVAL_MS=900000

# Sonarr and Radarr. Used by the media page (read) and the delete route (write).
# API key is in Settings -> General in each web UI.
SONARR_URL=http://192.168.178.241:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.178.241:7878
RADARR_API_KEY=

# Jellyseerr. Used ONLY to clear the request record after a film or show is
# deleted, so the title reads "not requested" again and can be re-requested.
# Optional: if unset, deletes still work and the cleanup step reports itself as
# skipped rather than failing. The key is in Settings -> General.
JELLYSEERR_URL=http://192.168.178.241:5055
JELLYSEERR_API_KEY=
