# Copy to `.env` on mulderserver, next to docker-compose.yml, and fill in.
# `.env` is gitignored and dockerignored — it is read by compose at run time and
# never baked into the image. Do not commit real values.

# qBittorrent WebUI. Reached through gluetun's published port, not its own.
# Username/password are OPTIONAL: qBittorrent's AuthSubnetWhitelist trusts the
# Docker subnet (172.16.0.0/12), so the dashboard needs no login. Set them only
# if that whitelist is ever removed.
QBIT_URL=http://192.168.178.241:8080
# QBIT_USERNAME=admin
# QBIT_PASSWORD=

# SABnzbd. The API key is in Config -> General in its web UI.
SAB_URL=http://192.168.178.241:8081
SAB_API_KEY=

# Minimum gap between speedtests, in ms. Defaults to 15 minutes.
# SPEEDTEST_MIN_INTERVAL_MS=900000
